# ── Discord (required) ────────────────────────────────────
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here
DISCORD_GUILD_ID=your_guild_id_here

# ── Binance (public endpoints — no key needed for signals) ─
BINANCE_BASE_URL=https://fapi.binance.com
# Optional: only needed for account/order data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Signal Config ──────────────────────────────────────────
# Comma-separated Binance USDT-M perpetual base assets
DEFAULT_WATCHLIST=BTC,ETH,XRP

# Risk profile: conservative | balanced | aggressive
DEFAULT_RISK_PROFILE=balanced

# Timeframes to analyse per symbol (comma-separated)
# Options: 5m, 15m, 1h, 4h, 1d
DEFAULT_TIMEFRAMES=15m,1h

# Minimum confidence % to fire a signal (per profile)
MIN_CONFIDENCE_CONSERVATIVE=80
MIN_CONFIDENCE_BALANCED=70
MIN_CONFIDENCE_AGGRESSIVE=60

# How often to scan all symbols (seconds). 300 = every 5 min
SCAN_INTERVAL_SECONDS=300

# ── News / Sentiment ───────────────────────────────────────
# Free tier at cryptopanic.com — leave empty to skip
CRYPTOPANIC_API_KEY=

# ── Backend ────────────────────────────────────────────────
API_PORT=8000
SECRET_KEY=change_this_to_a_long_random_string_in_production
# Comma-separated origins allowed for CORS
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Database ───────────────────────────────────────────────
# SQLite file path (relative to backend dir)
DATABASE_URL=sqlite:///./signalbot.db

# ── Frontend env (copy to frontend/.env.local) ─────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
